@model List<Category>
@{
    ViewData["Title"] = "Categorías";
}



<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Categorías</h1>
        <p class="text-secondary mb-0">Tipos de prenda del ropero solidario.</p>
    </div>
    @if (User.IsInRole(RoleNames.Admin))
    {
        <a class="btn btn-primary" asp-action="Create">Nueva categoría</a>
    }
</div>



<form method="get" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md">
            <label for="search" class="form-label">Nombre</label>
            <input id="search" name="search" class="form-control" placeholder="Nombre de la categoría" />
        </div>
        <div class="col-md">
            <label for="cantPrendas" class="form-label">Cantidad</label>
            <input id="cantPrendas" name="cantPrendas" class="form-control" placeholder="Cantidad de prendas" />
        </div>
        <div class="col-lg-2 col-12 d-flex gap-2">
            <button class="btn btn-primary" type="submit">
                Buscar
            </button>
            <a class="btn btn-outline-secondary w-100" asp-action="Index">
                Limpiar
            </a>
        </div>
    </div>
</form>



@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay Categorías que coincidan con la busqueda.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>

                    <th>Prendas</th>
                    
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="fw-semibold"><a asp-action="Details" asp-route-id="@category.Id">@category.Name</a></td>
                        <td>@category.Description</td>
                        <td>@category.ClothingItems.Count</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@category.Id">Ver</a>
                            @if (User.IsInRole(RoleNames.Admin))
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@category.Id">Editar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
