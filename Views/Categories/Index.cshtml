@model List<Category>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Categorías</h1>
        <p class="text-secondary mb-0">Tipos de prenda del ropero solidario.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nueva categoría</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no hay categorías.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Nombre</th><th>Descripción</th><th>Prendas</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="fw-semibold">@category.Name</td>
                        <td>@category.Description</td>
                        <td>@category.ClothingItems.Count</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@category.Id">Ver</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@category.Id">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
