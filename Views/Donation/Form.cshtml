@model Donation
@{
    // Un solo formulario para crear (Id = 0) y editar (Id > 0).
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Nueva donación" : "Editar donación";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</div>
<form asp-action="Save" method="post" class="card">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="DonorName" class="form-label">Nombre del benefactor</label>
                <input asp-for="DonorName" class="form-control" />
                <span asp-validation-for="DonorName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DonorEmail" class="form-label">Email del benefactor</label>
                <input asp-for="DonorEmail" type="email" class="form-control" />
                <span asp-validation-for="DonorEmail" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LocationId" class="form-label">Sede donde se entrega</label>
                <select asp-for="LocationId" asp-items="ViewBag.Locations" class="form-select"></select>
                <span asp-validation-for="LocationId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DonatedAt" class="form-label">Fecha de la donación</label>
                <input asp-for="DonatedAt" type="date" class="form-control" />
                <span asp-validation-for="DonatedAt" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label">Notas</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="card-footer bg-transparent text-end">
        <button class="btn btn-primary" type="submit">Guardar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

