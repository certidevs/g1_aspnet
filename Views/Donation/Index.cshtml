@model List<Donation>
@{
    ViewData["Title"] = "Donaciones";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Donaciones</h1>
    <a class="btn btn-success" asp-action="Create">Nueva donación</a>
</div>

<p>Hay @Model.Count Donaciones.</p>



<table class="table table-striped">
    <thead>
        <tr>

            <th>Nombre del benefactor</th>
            <th>Fecha de la donacion</th>
            <th>Notas</th>
            <th>Oficina</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var donation in Model)
        {
            <tr>

                <td>@donation.DonorName</td>
                <td>@donation.DonatedAt</td>
                <td>@donation.Notes</td>
                <td>@donation.Location?.Name</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@donation.Id">Ver</a>
      
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@donation.Id">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
