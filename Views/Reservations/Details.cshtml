@model Reservation
@{
    ViewData["Title"] = "Reserva " + Model.Id;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Reserva @Model.Id</h1>
    <div class="d-flex align-items-center gap-2">
        <span class="badge fs-6 text-bg-secondary">@Html.DisplayFor(m => m.Status)</span>
        @* DESCOMENTA: <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> *@
        @* DESCOMENTA DESDE AQUÍ
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('¿Seguro que quieres eliminar esta reserva?');">
            <button class="btn btn-outline-danger" type="submit">Eliminar</button>
        </form>
        FIN DESCOMENTA *@
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Prenda</dt>
    <dd class="col-sm-9">
        @if (Model.ClothingItem != null)
        {
            <a asp-controller="ClothingItems" asp-action="Details" asp-route-id="@Model.ClothingItem.Id">@Model.ClothingItem.Name</a>
        }
    </dd>

    <dt class="col-sm-3">Usuario</dt>
    <dd class="col-sm-9">@(Model.ApplicationUser?.DisplayName ?? Model.ApplicationUser?.UserName)</dd>

    <dt class="col-sm-3">Fecha de reserva</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Fecha de recogida</dt>
    <dd class="col-sm-9">@Model.PickupDate.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Caduca el</dt>
    <dd class="col-sm-9">@Model.ExpiresAt.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Notas</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Sin notas" : Model.Notes)</dd>
</dl>

<a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
