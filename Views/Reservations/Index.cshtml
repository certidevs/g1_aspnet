@model List<Reservation>
@{
    ViewData["Title"] = "Reservas";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Reservas</h1>
        <p class="text-secondary mb-0">Prendas reservadas para entrevistas de trabajo.</p>
    </div>
    @* DESCOMENTA: <a class="btn btn-primary" asp-action="Create">Nueva reserva</a> *@
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no hay reservas.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Prenda</th><th>Usuario</th><th>Estado</th><th>Recogida</th><th>Caduca</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var reservation in Model)
                {
                    <tr>
                        <td class="fw-semibold">@reservation.ClothingItem?.Name</td>
                        <td>@(reservation.ApplicationUser?.DisplayName ?? reservation.ApplicationUser?.UserName)</td>
                        <td><span class="badge text-bg-secondary">@Html.DisplayFor(m => reservation.Status)</span></td>
                        <td>@reservation.PickupDate.ToString("dd/MM/yyyy")</td>
                        <td>@reservation.ExpiresAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@reservation.Id">Ver</a>
                            @* DESCOMENTA: <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@reservation.Id">Editar</a> *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
