@model Location
@{
    ViewData["Title"] = Model.Name;
}

<h1>Localización de @Model.Name</h1>


<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Model.Name</h1>
    @if (User.IsInRole(RoleNames.Admin))
    {
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                onsubmit="return confirm('¿Seguro que quieres borrar esta localización?');">
                <button class="btn btn-danger" type="submit">Borrar</button>
            </form>
        </div>
    }
</div>


<dl class="row">
    <dt class="col-sm-3">Nombre de la Localización</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Ciudad</dt>
    <dd class="col-sm-9">@Model.City</dd>

    <dt class="col-sm-3">Codigo postal</dt>
    <dd class="col-sm-9">@Model.PostalCode</dd>

    <dt class="col-sm-3">Numero de telefono</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    <dt class="col-sm-3">Horas de apertura</dt>
    <dd class="col-sm-9">@Model.OpeningHours</dd>
</dl>

<h2 class="h4 mt-4">Lista de ropa</h2>
@if (Model.ClothingItems.Count == 0)
{
    <p class="text-secondary">No se dono ropa en esta localización.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre de la prenda</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var clothingItem in Model.ClothingItems.OrderBy(c => c.Name))
            {
                <tr>
                    <td><a asp-controller="ClothingItem" asp-action="Details" asp-route-id="@clothingItem.Id">@clothingItem.Name</a></td>
                </tr>
            }
        </tbody>
    </table>
}




<h2 class="h4 mt-4">Lista de donaciones</h2>
@if (Model.Donations.Count == 0)
{
    <p class="text-secondary">No se hicieron donaciones a esta localización.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre del donador</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var donation in Model.Donations.OrderBy(c => c.DonatedAt))
            {
                <tr>
                    <td><a asp-controller="Donation" asp-action="Details" asp-route-id="@donation.Id">@donation.DonorName</a></td>
                </tr>
            }
        </tbody>
    </table>
}


<a class="btn btn-secondary" asp-action="Index">Volver al listado</a>


@* cambio sugerido por Alan
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@Model.Name</h1>
    <div class="d-flex align-items-center gap-2">
        <span class="badge fs-6 @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.IsActive ? "Activa" : "Inactiva")</span>
        @if (User.IsInRole(RoleNames.Admin))
        {
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>


            if (Model.IsActive)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('¿Seguro que quieres desactivar esta localización?');">
                    <button class="btn btn-outline-danger" type="submit">Desactivar</button>
                </form>
            }
        }
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Dirección</dt>
    <dd class="col-sm-9">@Model.Address</dd>

    <dt class="col-sm-3">Ciudad</dt>
    <dd class="col-sm-9">@Model.PostalCode @Model.City</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    <dt class="col-sm-3">Horario</dt>
    <dd class="col-sm-9">@Model.OpeningHours</dd>
</dl>

<h2 class="h4 mt-4">Prendas guardadas aquí (@Model.ClothingItems.Count)</h2>
@if (Model.ClothingItems.Count == 0)
{
    <p class="text-secondary">No hay prendas guardadas en esta sede.</p>
}
else
{
    <div class="table-responsive border rounded mb-4">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Prenda</th><th>Talla</th><th>Estado</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ClothingItems.OrderBy(i => i.Name))
                {
                    <tr>
                        <td><a asp-controller="ClothingItems" asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td>
                        <td>@item.Size</td>
                        <td>@Html.DisplayFor(m => item.Status)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4 mt-4">Donaciones recibidas (@Model.Donations.Count)</h2>
@if (Model.Donations.Count == 0)
{
    <p class="text-secondary">Todavía no se ha recibido ninguna donación en esta sede.</p>
}
else
{
    <div class="table-responsive border rounded mb-4">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Benefactor</th><th>Fecha</th></tr>
            </thead>
            <tbody>
                @foreach (var donation in Model.Donations.OrderByDescending(d => d.DonatedAt))
                {
                    <tr>
                        <td><a asp-controller="Donation" asp-action="Details" asp-route-id="@donation.Id">@donation.DonorName</a></td>
                        <td>@donation.DonatedAt.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
*@
