@model Location
@{
    ViewData["Title"] = Model.Name;
}

<h1>Localización de @Model.Name</h1>


<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Model.Name</h1>
    @if (User.IsInRole(RoleNames.Admin))
    {
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                onsubmit="return confirm('¿Seguro que quieres borrar esta localización?');">
                <button class="btn btn-danger" type="submit">Borrar</button>
            </form>
        </div>
    }
</div>

<div class="row mt-4">

    @* Columna izquierda *@
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-3">Nombre de la Localización</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Ciudad</dt>
            <dd class="col-sm-9">@Model.City</dd>

            <dt class="col-sm-3">Codigo postal</dt>
            <dd class="col-sm-9">@Model.PostalCode</dd>

            <dt class="col-sm-3">Numero de telefono</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Horas de apertura</dt>
            <dd class="col-sm-9">@Model.OpeningHours</dd>
        </dl>
    </div>

    @* Columna derecha *@
    <div class="col-md-6">
        <img src="https://ecool.es/img/cms/Tiendas/WhatsApp%20Image%202022-03-18%20at%2011-12-07%20(1)_1.jpeg" alt="" 
            style="min-width: 150px;
                max-width: 300px;
                min-height: 150px;
                max-height: 300px;
                object-fit: cover;
        ">
    </div>

</div>





<div class="row mt-4">

    @* Columna izquierda: Lista de ropa *@
    <div class="col-md-6">
        <h2 class="h4">Lista de ropa</h2>

        @if (Model.ClothingItems.Count == 0)
        {
            <p class="text-secondary">
                No se donó ropa en esta localización.
            </p>
        }
        else
        {
            <div class="card p-3">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nombre de la prenda</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var clothingItem in Model.ClothingItems.OrderBy(c => c.Name))
                        {
                            <tr>
                                <td>
                                    <a asp-controller="ClothingItems"
                                       asp-action="Details"
                                       asp-route-id="@clothingItem.Id">
                                        @clothingItem.Name
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* Columna derecha: Lista de donaciones. Lleva nombres de donantes (datos personales): solo para el Admin. *@
    @if (User.IsInRole(RoleNames.Admin))
    {
    <div class="col-md-6">
        <h2 class="h4">Lista de donaciones</h2>

        @if (Model.Donations.Count == 0)
        {
            <p class="text-secondary">
                No se hicieron donaciones a esta localización.
            </p>
        }
        else
        {
            <div class="card p-3">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nombre del donador</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var donation in Model.Donations.OrderBy(c => c.DonatedAt))
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Donations"
                                       asp-action="Details"
                                       asp-route-id="@donation.Id">
                                        @donation.DonorName
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    }

</div>

<br>
<a class="btn btn-secondary" asp-action="Index">Volver al listado</a>