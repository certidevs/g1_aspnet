@* Formulario de EJEMPLO, el modelo a copiar. @model dice qué objeto recibe la vista (lo manda el controlador). *@
@model Location
@{
    // Un solo formulario para crear (Id = 0) y editar (Id > 0).
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Nueva localización" : "Editar localización";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</div>

@* asp-action="Save" envía el formulario por POST a LocationController.Save (con el token antifalsificación incluido). *@
<form asp-action="Save" method="post" class="card">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        @* El Id va oculto: así Save sabe si es una sede nueva (0) o una que se edita. *@
        <input type="hidden" asp-for="Id" />
        @* asp-for enlaza cada campo con una propiedad del modelo: pone el nombre, el valor y la validación.
           asp-validation-for enseña debajo el mensaje de error de esa propiedad. *@
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Nombre</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="City" class="form-label">Ciudad</label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="col-md-9">
                <label asp-for="Address" class="form-label">Dirección</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="PostalCode" class="form-label">Código postal</label>
                <input asp-for="PostalCode" class="form-control" />
                <span asp-validation-for="PostalCode" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Phone" class="form-label">Teléfono</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="OpeningHours" class="form-label">Horario</label>
                <input asp-for="OpeningHours" class="form-control" placeholder="L-V 9:00-14:00" />
                <span asp-validation-for="OpeningHours" class="text-danger"></span>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Activa</label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer bg-transparent text-end">
        <button class="btn btn-primary" type="submit">Guardar</button>
    </div>
</form>

@* Carga la validación en el navegador (jQuery Validate) antes de enviar. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
