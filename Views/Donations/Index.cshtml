@model List<Donation>
@{
    ViewData["Title"] = "Donaciones";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Donaciones</h1>
    <a class="btn btn-success" asp-action="Create">Nueva donación</a>
</div>

<p>Hay @Model.Count Donaciones.</p>

<form method="get" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md">
            <label for="search" class="form-label">Nombre del benefactor</label>
            <input id="search" name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Nombre del benefactor" />
        </div>
        <div class="col-md-auto"><button class="btn btn-primary" type="submit">Buscar</button></div>
        <div class="col-md-auto"><a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a></div>
    </div>
</form>


<table class="table table-striped">
    <thead class="text-nowrap">
        <tr>

            <th>Nombre del
                benefactor <a class="text-reset text-decoration-none" asp-action="Index" asp-route-shortBy="name"
                              asp-route-descending="true"><i class="bi bi-arrow-up"></a></i>
                <a class="text-reset text-decoration-none" asp-action="Index" asp-route-shortBy="name"
                   asp-route-descending="false"><i class="bi bi-arrow-down"></i></a>


            </th>
            <th>Fecha de la
                donacion<a class="text-reset text-decoration-none" asp-action="Index" asp-route-shortBy="date"
                           asp-route-descending="true"><i class="bi bi-arrow-up"></a></i>
                <a class="text-reset text-decoration-none" asp-action="Index" asp-route-shortBy="date"
                   asp-route-descending="false"><i class="bi bi-arrow-down"></i></a>
            </th>
            <th>Notas</th>
            <th>Oficina<a class="text-reset text-decoration-none" asp-action="Index" asp-route-shortBy="location"
                              asp-route-descending="true"><i class="bi bi-arrow-up"></a></i>
                <a class="text-reset text-decoration-none" asp-action="Index" asp-route-shortBy="location"
                   asp-route-descending="false"><i class="bi bi-arrow-down"></i></a>
            </th>
            <th></th>

        </tr>
    </thead>
    <tbody>
        @foreach (var donation in Model)
        {
            <tr>

                <td><a asp-action="Details" asp-route-id="@donation.Id">@donation.DonorName</a></td>
                <td>@donation.DonatedAt</td>
                <td>@donation.Notes</td>
                <td>@donation.Location?.Name</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@donation.Id">Ver</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@donation.Id">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
