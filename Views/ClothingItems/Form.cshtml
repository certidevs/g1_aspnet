@model ClothingItem
@{
    // Un solo formulario para crear (Id = 0) y editar (Id > 0).
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Nueva prenda" : "Editar prenda";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</div>

<form asp-action="Save" method="post" class="col-lg-8" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" id="returnToDonation" name="returnToDonation" value="@ViewBag.returnToDonation" />

    <div class="mb-3">
        <label class="form-label" asp-for="Name">Nombre</label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Description">Descripción</label>
        <input class="form-control" asp-for="Description" />
        <span class="text-danger" asp-validation-for="Description"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="CategoryId">Categoría</label>
        <select class="form-select" asp-for="CategoryId" asp-items="ViewBag.Categories"></select>
        <span class="text-danger" asp-validation-for="CategoryId"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="LocationId">Sede</label>
        <select class="form-select" asp-for="LocationId" asp-items="ViewBag.Locations"></select>
        <span class="text-danger" asp-validation-for="LocationId"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="DonationId">Donación</label>
        <select class="form-select" asp-for="DonationId" asp-items="ViewBag.Donations"></select>
        <span class="text-danger" asp-validation-for="DonationId"></span>
    </div>

    @* TODO: Los select de enums no seleccionan por defecto los options placeholder *@
    <div class="mb-3">
        <label class="form-label" asp-for="Color">Color</label>
        <select class="form-select" asp-for="Color" asp-items="Html.GetEnumSelectList<ClothingColor>()">
            <option value="">Selecciona el color</option>
        </select>
        <span class="text-danger" asp-validation-for="Color"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Material">Material</label>
        <select class="form-select" asp-for="Material" asp-items="Html.GetEnumSelectList<ClothingMaterial>()">
            <option value="">Selecciona el material</option>
        </select>
        <span class="text-danger" asp-validation-for="Material"></span>
    </div>
    
    <div class="mb-3">
        <label class="form-label" asp-for="SizeType">Tipo de talla</label>
        <select class="form-select" asp-for="SizeType" asp-items="Html.GetEnumSelectList<SizeType>()">
            <option value="">Selecciona el tipo de talla</option>
        </select>
        <span class="text-danger" asp-validation-for="SizeType"></span>
    </div>

    <div class="mb-3">
        @* TODO: Cambiar por un select distinto por cada SizeTipe *@
        <label class="form-label" asp-for="Size">Talla</label>
        <input class="form-control" asp-for="Size" />
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Condition">Condición</label>
        <select class="form-select" asp-for="Condition" asp-items="Html.GetEnumSelectList<ItemCondition>()">
            <option value="">Selecciona la condición de la prenda</option>
        </select>
        <span class="text-danger" asp-validation-for="Condition"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Status">Estado</label>
        <select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<ItemStatus>()">
            <option value="">Selecciona el estado de la prenda</option>
        </select>
        <span class="text-danger" asp-validation-for="Status"></span>
    </div>

    <div>
        <label class="form-label" asp-for="ImageFile">Imagen de la prenda</label>

        <input class="form-control" asp-for="ImageFile" type="file" accept="image/*"/>
    </div>


    <button class="btn btn-primary" type="submit">Guardar</button>
    <a class="btn btn-outline-secondary">Cancelar</a>
    
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}